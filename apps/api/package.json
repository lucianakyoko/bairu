{
  "name": "@bairu/api",
  "version": "0.1.0",
  "private": true,
  "description": "Bairu backend API",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.spec.json --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:test": "node scripts/with-env.mjs test prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@bairu/config-eslint": "workspace:*",
    "@bairu/config-prettier": "workspace:*",
    "@bairu/config-typescript": "workspace:*",
    "@jest/globals": "^30.5.1",
    "@nestjs/cli": "^11",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
