{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "rootDir": "./src",
    "types": ["node", "jest"],
    "isolatedModules": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.spec.ts"]
}
